# ------------------------------------------------------------------
# Ashir Partner Hub — configuracion de la capa de datos
# Copiar a apps/web/.env y ajustar. No incluir credenciales reales.
# ------------------------------------------------------------------

# mock  -> adaptador local con datos simulados (predeterminado, no requiere backend)
# api   -> adaptador REST contra VITE_API_BASE_URL (todavia no existe backend real)
VITE_DATA_MODE=mock

# Base de la API futura. Hoy es un placeholder: no hay servicio publicado.
VITE_API_BASE_URL=https://api.example.ashir.com.ar/v1

# Habilita el Centro de Desarrolladores dentro de la app
VITE_API_DOCS_ENABLED=true

# Latencia simulada del adaptador mock (ms)
VITE_MOCK_LATENCY_MIN=250
VITE_MOCK_LATENCY_MAX=900
